{
  "name": "dota-live-hud",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-23",

  // Serves everything in /public automatically (index.html, app.js, style.css).
  // Requests that don't match a file (/gsi, /ws, /state) fall through to the
  // Worker code in src/worker.js.
  "assets": {
    "directory": "./public"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_HUB",
        "class_name": "GameStateHub"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameStateHub"]
    }
  ]
}
